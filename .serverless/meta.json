{
  "/Users/amandatana/Desktop/shui/serverless.yml": {
    "versionFramework": "4.46.0",
    "servicePath": "/Users/amandatana/Desktop/shui/serverless.yml",
    "serviceConfigFileName": "serverless.yml",
    "service": {
      "org": "amandatanaskovic",
      "service": "shui",
      "frameworkVersion": "4",
      "provider": {
        "name": "aws",
        "runtime": "nodejs24.x",
        "region": "eu-north-1",
        "stage": "dev",
        "environment": {
          "USERS_TABLE": "shui-dev-users",
          "POSTS_TABLE": "shui-dev-posts"
        },
        "iam": {
          "role": "arn:aws:iam::239998536284:role/cupify-lambda-role"
        },
        "versionFunctions": true
      },
      "functions": {
        "register": {
          "handler": "functions/auth/register/index.handler",
          "events": [
            {
              "httpApi": {
                "path": "/auth/register",
                "method": "POST"
              }
            }
          ],
          "name": "shui-dev-register"
        },
        "login": {
          "handler": "functions/auth/login/index.handler",
          "events": [
            {
              "httpApi": {
                "path": "/auth/login",
                "method": "POST"
              }
            }
          ],
          "name": "shui-dev-login"
        },
        "getPosts": {
          "handler": "functions/posts/getPosts/index.handler",
          "events": [
            {
              "httpApi": {
                "path": "/posts",
                "method": "GET"
              }
            }
          ],
          "name": "shui-dev-getPosts"
        },
        "getPost": {
          "handler": "functions/posts/getPost/index.handler",
          "events": [
            {
              "httpApi": {
                "path": "/posts/{postId}",
                "method": "GET"
              }
            }
          ],
          "name": "shui-dev-getPost"
        },
        "addPost": {
          "handler": "functions/posts/addPost/index.handler",
          "events": [
            {
              "httpApi": {
                "path": "/posts",
                "method": "POST"
              }
            }
          ],
          "name": "shui-dev-addPost"
        },
        "updatePost": {
          "handler": "functions/posts/updatePost/index.handler",
          "events": [
            {
              "httpApi": {
                "path": "/posts/{postId}",
                "method": "PUT"
              }
            }
          ],
          "name": "shui-dev-updatePost"
        },
        "deletePost": {
          "handler": "functions/posts/deletePost/index.handler",
          "events": [
            {
              "httpApi": {
                "path": "/posts/{postId}",
                "method": "DELETE"
              }
            }
          ],
          "name": "shui-dev-deletePost"
        }
      },
      "resources": {
        "Resources": {
          "UsersTable": {
            "Type": "AWS::DynamoDB::Table",
            "Properties": {
              "TableName": "shui-dev-users",
              "BillingMode": "PAY_PER_REQUEST",
              "AttributeDefinitions": [
                {
                  "AttributeName": "username",
                  "AttributeType": "S"
                }
              ],
              "KeySchema": [
                {
                  "AttributeName": "username",
                  "KeyType": "HASH"
                }
              ]
            }
          },
          "PostsTable": {
            "Type": "AWS::DynamoDB::Table",
            "Properties": {
              "TableName": "shui-dev-posts",
              "BillingMode": "PAY_PER_REQUEST",
              "AttributeDefinitions": [
                {
                  "AttributeName": "id",
                  "AttributeType": "S"
                },
                {
                  "AttributeName": "feedKey",
                  "AttributeType": "S"
                },
                {
                  "AttributeName": "createdAtId",
                  "AttributeType": "S"
                }
              ],
              "KeySchema": [
                {
                  "AttributeName": "id",
                  "KeyType": "HASH"
                }
              ],
              "GlobalSecondaryIndexes": [
                {
                  "IndexName": "posts-by-date-index",
                  "KeySchema": [
                    {
                      "AttributeName": "feedKey",
                      "KeyType": "HASH"
                    },
                    {
                      "AttributeName": "createdAtId",
                      "KeyType": "RANGE"
                    }
                  ],
                  "Projection": {
                    "ProjectionType": "ALL"
                  }
                }
              ]
            }
          }
        }
      }
    },
